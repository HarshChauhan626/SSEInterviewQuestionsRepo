---
import Layout from '../layouts/Layout.astro';
import topicsData from '../../dsa-questions-data/index.json';

interface Topic {
  file: string;
  topic: string;
  description: string;
  icon: string;
  accent: string;
  count: number;
}

const topics: Topic[] = topicsData;
---

<Layout title="Topics - Interview Questions">
  <section class="hero mb-16">
    <div class="mb-4">
      <span class="section-tag text-[var(--accent-warn)]">Browse all topics</span>
    </div>
    <h1 class="mb-4">All Interview Topics</h1>
    <p class="hero p text-lg text-[var(--text-dim)] max-w-3xl mb-8">
      Explore our comprehensive collection of interview questions organized by topic and difficulty level.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-16">
    {topics.map((topic: Topic) => (
      <a 
        href={`/topics/${topic.file.replace('dsa-questions-data/', '').replace('.json', '')}`}
        class="card group hover:border-[var(--accent-grpc)] transition-all duration-200 cursor-pointer"
        style={`border-top-color: ${topic.accent}`}
      >
        <div class="flex items-start gap-3 mb-3">
          <span class="text-2xl">{topic.icon}</span>
          <div class="flex-1">
            <h3 class="text-sm font-bold text-[var(--text)] group-hover:text-[var(--accent-grpc)] transition">
              {topic.topic}
            </h3>
          </div>
        </div>
        <p class="text-xs text-[var(--text-dim)] mb-3 leading-relaxed">
          {topic.description}
        </p>
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-[var(--text-faint)]">
            {topic.count} questions
          </span>
          <span class="text-xs text-[var(--accent-grpc)]">→</span>
        </div>
      </a>
    ))}
  </div>

  <div class="callout tip">
    <p class="text-sm">
      💡 Start with <strong>DSA: Easy to Medium</strong> to build fundamentals, then progress to more advanced topics.
    </p>
  </div>
</Layout>
