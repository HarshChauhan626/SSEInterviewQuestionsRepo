---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - SSE Interview Questions">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold mb-4">SSE Interview Questions</h1>
      <p class="text-xl text-gray-600">Master System Design, Data Structures, Algorithms, and More</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12">
      <div class="bg-blue-50 p-6 rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-4 text-blue-600">🎯 System Design</h2>
        <p class="text-gray-700">Learn system design patterns, architectural concepts, and real-world design challenges.</p>
        <a href="/topics" class="text-blue-600 hover:underline mt-4 inline-block">Explore →</a>
      </div>

      <div class="bg-green-50 p-6 rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-4 text-green-600">📊 Data Structures</h2>
        <p class="text-gray-700">Master arrays, linked lists, trees, graphs, and other essential data structures.</p>
        <a href="/topics" class="text-green-600 hover:underline mt-4 inline-block">Explore →</a>
      </div>

      <div class="bg-purple-50 p-6 rounded-lg shadow">
        <h2 class="text-2xl font-bold mb-4 text-purple-600">⚡ Algorithms</h2>
        <p class="text-gray-700">Practice sorting, searching, dynamic programming, and advanced algorithms.</p>
        <a href="/topics" class="text-purple-600 hover:underline mt-4 inline-block">Explore →</a>
      </div>
    </div>

    <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white p-8 rounded-lg text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to ace your interviews?</h2>
      <p class="mb-6 text-lg">Start exploring our comprehensive collection of interview questions and solutions.</p>
      <a href="/topics" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-bold hover:bg-gray-100 inline-block">
        Get Started
      </a>
    </div>
  </div>
</Layout>
