---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <div class="max-w-4xl mx-auto px-4 py-12 text-center">
    <div class="mb-8">
      <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
      <h2 class="text-3xl font-bold text-gray-700 mb-4">Page Not Found</h2>
      <p class="text-xl text-gray-600 mb-8">Sorry, the page you're looking for doesn't exist.</p>
      <a href="/" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 inline-block">
        Go Home
      </a>
    </div>
  </div>
</Layout>
