---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found">
  <section class="hero mb-16">
    <div class="text-center">
      <div class="mb-6">
        <div class="text-6xl font-mono font-bold text-[var(--accent-bad)] mb-4">404</div>
        <h1 class="mb-4">Page Not Found</h1>
        <p class="text-lg text-[var(--text-dim)] max-w-2xl mx-auto mb-8">
          Looks like you've wandered into uncharted territory. The page you're looking for doesn't exist.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/"
          class="px-6 py-3 bg-gradient-to-r from-[var(--accent-gql)] to-[var(--accent-grpc)] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[rgba(229,53,171,0.3)] transition-all"
        >
          ← Back Home
        </a>
        <a 
          href="/topics"
          class="px-6 py-3 border border-[var(--border)] text-[var(--accent-grpc)] font-semibold rounded-lg hover:bg-[var(--bg-card)] transition-all"
        >
          Browse Topics
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="mb-20">
    <div class="mb-8">
      <h2 class="text-center flex items-center justify-center gap-3">
        <span class="w-1 h-8 bg-[var(--accent-grpc)] rounded-full"></span>
        <span>Quick Links</span>
      </h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-3xl mx-auto">
      <a href="/" class="card group hover:border-[var(--accent-grpc)] transition-all">
        <div class="text-2xl mb-3">🏠</div>
        <h4 class="text-sm font-bold mb-1 group-hover:text-[var(--accent-grpc)]">Home</h4>
        <p class="text-xs text-[var(--text-dim)]">Back to the main hub</p>
      </a>
      <a href="/topics" class="card group hover:border-[var(--accent-grpc)] transition-all">
        <div class="text-2xl mb-3">📚</div>
        <h4 class="text-sm font-bold mb-1 group-hover:text-[var(--accent-grpc)]">Topics</h4>
        <p class="text-xs text-[var(--text-dim)]">Browse all categories</p>
      </a>
      <a href="/about" class="card group hover:border-[var(--accent-grpc)] transition-all">
        <div class="text-2xl mb-3">ℹ️</div>
        <h4 class="text-sm font-bold mb-1 group-hover:text-[var(--accent-grpc)]">About</h4>
        <p class="text-xs text-[var(--text-dim)]">Learn more</p>
      </a>
    </div>
  </section>
</Layout>
